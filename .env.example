# Development environment — DO NOT use in production
# Optional: bypass PII and weak-password checks in local development.
# JWT configuration is still required.
# CPNET_INSECURE_DEV=1
DB_PASSWORD=change-me

# RS256 JWT keys
# Generate repo-local dev keys with:
#   ./scripts/generate-dev-jwt.sh
#   # or: pwsh ./scripts/generate-dev-jwt.ps1
JWT_ACTIVE_KID=dev-key-1
JWT_PRIVATE_KEY_PATH=.dev/jwt/jwt_private.pem
JWT_PUBLIC_KEYS_PATH=.dev/jwt/jwt_public_keys.json

# Group key rotation interval (hours)
GROUP_KEY_ROTATION_INTERVAL_HOURS=24
INITIAL_ADMIN=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_EMAIL=admin@localhost

# PII encryption keys (base64-encoded 32-byte keys, required unless CPNET_INSECURE_DEV=1)
# Generate with: openssl rand -base64 32
PII_MASTER_KEY=
PII_HMAC_KEY=

# SMTP (leave empty to disable email verification in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Base URL for email links (e.g. verification, password reset)
BASE_URL=http://localhost:39271

# CORS allowed origins (comma-separated, empty = same-origin only)
ALLOWED_ORIGINS=

# Registration (true/false)
REGISTRATION_OPEN=true

# OIDC / Social Login (leave empty to disable)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
