{{!-- Tauri's default Linux desktop entry plus `%u` on the Exec line. Without it, opening a
cpmesh:// link (the browser sign-in callback) starts the app without the URL, so the code in
it never reaches the running app. Used for the .deb and .rpm packages and inside the AppImage. --}}
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
