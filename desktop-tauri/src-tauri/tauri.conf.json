{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cpmesh",
  "version": "0.1.0",
  "identifier": "com.cpmesh.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cpmesh",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "cpmesh - Clipboard Sync"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Encrypted clipboard sync across devices",
    "longDescription": "cpmesh is a self-hosted, end-to-end encrypted clipboard sync tool. Copy on one device, paste on another instantly.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/cpmesh.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/cpmesh.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["cpmesh"]
      }
    }
  }
}
